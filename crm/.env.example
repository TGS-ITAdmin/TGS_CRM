# Server
PORT=3002
MONGODB_URI=mongodb://127.0.0.1:27017/tgs_crm
# Required. The server refuses to start without a real one, because tokens
# signed with a guessable secret can be forged by anyone who reads this repo.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Public base URL of the app. Used to build unsubscribe links in outgoing email.
# In production set this to your real domain, e.g. https://crm.tgsbpo.com
APP_BASE_URL=http://localhost:3002

# The first admin account, created once on first connect.
# Leave SEED_ADMIN_PASSWORD blank and a random one is generated and printed to
# the logs on first boot — better than a password that lives in a repository.
SEED_ADMIN_EMAIL=admin@tgsbpo.com
SEED_ADMIN_PASSWORD=

# Optional shared secret required by the public web-form endpoint.
# Leave blank to allow unauthenticated form posts.
PUBLIC_FORM_TOKEN=

# How often the stage engine runs (cron expression). Default: every 15 minutes.
SCHEDULER_CRON=*/15 * * * *
